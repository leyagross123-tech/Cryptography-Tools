#This program will rewrite word_list
#to update dictionary
import linguistic_functions as lf
flag = False
file_name = input('Enter path/to/file.txt.\n>> ')
unique_words = []
words_to_write = []
with open('word_list.txt','a+') as dictionary:
    dictionary.seek(0)
    dictionary = dictionary.read().split('\n')
    unique_words=[word for word in dictionary]
    unique_words = list(set(unique_words))
while not flag:
    file = open(file_name,'r',encoding='utf-8')
    read_file = file.read()
    file.close()
    read_file = read_file.replace('-\n','').replace('\n-','').replace('-',' ').replace('\n',' ')
    read_file = lf.clean(read_file, ' ')
    read_file = read_file.split(' ')

    for word in read_file:
        if word not in unique_words:
            words_to_write.append(word)
            unique_words.append(word)
    with open('words_list.txt','a+') as file:
        for word in words_to_write:
            file.write(word)
            file.write('\n')
    print('File done. There were',len(words_to_write),'words added.')
    file_name = input('Enter path/to/file.txt, -1 to end.\n>> ')
    if file_name == '-1':
        flag=True
    
